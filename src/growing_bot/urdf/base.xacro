<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="growing_bot">

    <xacro:include filename="$(find growing_bot)/urdf/materials.xacro" />
    <xacro:include filename="$(find growing_bot)/urdf/macros.xacro" />

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="base_mass" value="20.0" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" /> 
    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.1" />
    <xacro:property name="camera_height" value="0.05" />
    <xacro:property name="camera_horizontal_fov" value="60" />

    <xacro:property name="two_d_lidar_height" value="0.06" />
    <xacro:property name="two_d_lidar_radius" value="0.075" />
    <xacro:property name="two_d_lidar_update_rate" value="30" />
    <xacro:property name="two_d_lidar_sample_size" value="361" />
    <xacro:property name="two_d_lidar_min_angle" value="0" />
    <xacro:property name="two_d_lidar_max_angle" value="360" />
    <xacro:property name="two_d_lidar_min_range" value="0.55" />
    <xacro:property name="two_d_lidar_max_range" value="16" />

    <xacro:arg name="robot_namespace" default=""/>
    <xacro:arg name="wheel_odom_topic" default="odom" />
    <xacro:arg name="camera_enabled" default="false" />
    <xacro:arg name="stereo_camera_enabled" default="false" />
    <xacro:arg name="two_d_lidar_enabled" default="false" />
    <xacro:arg name="publish_wheel_odom_tf" default="true" />
    <xacro:arg name="conveyor_enabled" default="false"/>
    <xacro:arg name="ground_truth_frame" default="map"/>
    <xacro:arg name="sim_gazebo" default="false" />
    <xacro:arg name="sim_ign" default="false" />
    <xacro:arg name="sim_gz" default="false" />
    <xacro:arg name="odometry_source" default="world" />
    <xacro:arg name="ros_control_enabled" default="false"/>

    <xacro:property name="odometry_source" value="$(arg odometry_source)"/>          

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <material name="green" />
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <mass value="${base_mass}" />
            <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}" />
        </inertial>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <material name="red" />
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
            </collision>            
            <inertial>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
                <mass value="1.0" />
                <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}" />
            </inertial>
        </link>    
    </xacro:macro>

    <xacro:wheel_link prefix="left" />
    <xacro:wheel_link prefix="right" />

    <link name="caster_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius/2}" />
            </geometry>
            <material name="red" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius/2}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>          
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.05" />
            <xacro:sphere_inertia m="0.05" r="${wheel_radius/2}" />
        </inertial>
    </link>     

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />      
    </joint>

    <joint name="base_left_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel_link" />
        <!-- Drive wheels at +x so cmd_vel +x (forward) leads; caster trails at rear -->
        <origin xyz="${base_length/4} ${base_width/2+wheel_length/2} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <!-- Required so gazebo_ros2_control SetVelocity(0) can brake (fmax); else freewheel creep -->
        <limit effort="20.0" velocity="10.0" />
    </joint>

    <joint name="base_right_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${base_length/4} ${-(base_width/2+wheel_length/2)} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="20.0" velocity="10.0" />
    </joint>  

    <joint name="base_caster_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_link" />
        <origin xyz="${-(base_length/2-wheel_radius)} 0 ${-wheel_radius/2}" rpy="0 0 0" />      
    </joint>  

    <!-- 2D LIDAR -->
    <xacro:if value="$(arg two_d_lidar_enabled)">
        <link name="two_d_lidar">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${two_d_lidar_height}" radius="${two_d_lidar_radius}" />
                </geometry>
                <material name="aluminium" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="${two_d_lidar_height}" radius="${two_d_lidar_radius}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.1" />
                <xacro:cylinder_inertia m="0.1" r="${two_d_lidar_radius}" h="${two_d_lidar_height}" />
            </inertial>
        </link>

        <joint name="two_d_lidar_joint" type="fixed">
            <parent link="base_link" />
            <child link="two_d_lidar" />
            <origin xyz="0 0 ${base_height + two_d_lidar_height/2}" rpy="0 0 0" />
        </joint>
    </xacro:if>

    <!-- IMU -->
    <link name="imu_frame" />

    <joint name="imu_joint" type="fixed">
        <parent link="base_link" />
        <child link="imu_frame" />
        <origin xyz="0 0 ${base_height}" rpy="0 0 0" />
    </joint>

    <!-- CAMERA -->
    <xacro:if value="$(arg camera_enabled)">
        <link name="kinect_camera">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${camera_length} ${camera_width} ${camera_height}" />
                </geometry>
                <material name="red" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${camera_length} ${camera_width} ${camera_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.1" />
                <xacro:box_inertia m="0.1" x="${camera_length}" y="${camera_width}" z="${camera_height}" />
            </inertial>
        </link>

        <joint name="kinect_camera_joint" type="fixed">
            <parent link="base_link" />
            <child link="kinect_camera" />
            <origin xyz="${base_length/2 + camera_length/2} 0 ${base_height/2}" rpy="0 0 0" />
        </joint>

        <link name="kinect_camera_optical" />

        <joint name="kinect_camera_optical_joint" type="fixed">
            <parent link="kinect_camera" />
            <child link="kinect_camera_optical" />
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        </joint>
    </xacro:if>

    <!-- STEREO CAMERA -->
    <xacro:if value="$(arg stereo_camera_enabled)">
        <link name="stereo_camera">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${camera_length} ${camera_width} ${camera_height}" />
                </geometry>
                <material name="red" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${camera_length} ${camera_width} ${camera_height}" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.1" />
                <xacro:box_inertia m="0.1" x="${camera_length}" y="${camera_width}" z="${camera_height}" />
            </inertial>
        </link>

        <joint name="stereo_camera_joint" type="fixed">
            <parent link="base_link" />
            <child link="stereo_camera" />
            <origin xyz="${base_length/2 + camera_length/2} 0 ${base_height/2}" rpy="0 0 0" />
        </joint>

        <link name="stereo_camera_optical" />

        <joint name="stereo_camera_optical_joint" type="fixed">
            <parent link="stereo_camera" />
            <child link="stereo_camera_optical" />
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        </joint>
    </xacro:if>    

    <!-- ROS CONTROL -->
    <xacro:if value="$(arg ros_control_enabled)">
        <xacro:include filename="$(find growing_bot)/urdf/ros_control.xacro" />
    </xacro:if>

</robot>