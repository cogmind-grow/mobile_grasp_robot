<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/xacro">

    <xacro:include filename="$(find growing_bot)/urdf/macros.xacro" />

    <!-- arm base -->
    <xacro:property name="arm_base_length" value="0.4" />
    <xacro:property name="arm_base_width" value="0.4" />
    <xacro:property name="arm_base_height" value="0.1" />
    <xacro:property name="arm_base_mass" value="2.0" />

    <!-- shoulder -->
    <xacro:property name="shoulder_length" value="0.5" />
    <xacro:property name="shoulder_radius" value="0.1" />
    <xacro:property name="shoulder_mass" value="1.5" />

    <!-- upper arm -->
    <xacro:property name="arm_length" value="0.6" />
    <xacro:property name="arm_radius" value="0.05" />
    <xacro:property name="arm_mass" value="1.0" />

    <!-- elbow -->
    <xacro:property name="elbow_length" value="0.1" />
    <xacro:property name="elbow_radius" value="0.05" />
    <xacro:property name="elbow_mass" value="0.3" />

    <!-- forearm -->
    <xacro:property name="forearm_length" value="0.5" />
    <xacro:property name="forearm_radius" value="0.05" />
    <xacro:property name="forearm_mass" value="0.8" />

    <!-- wrist -->
    <xacro:property name="wrist_length" value="0.1" />
    <xacro:property name="wrist_width" value="0.1" />
    <xacro:property name="wrist_height" value="0.05" />
    <xacro:property name="wrist_mass" value="0.2" />

    <!-- hand -->
    <xacro:property name="hand_length" value="0.1" />
    <xacro:property name="hand_width" value="0.1" />
    <xacro:property name="hand_height" value="0.02" />
    <xacro:property name="hand_mass" value="0.1" />

    <!-- joint limits / dynamics -->
    <xacro:property name="arm_joint_effort" value="1000" />
    <xacro:property name="arm_joint_velocity" value="1.0" />
    <xacro:property name="wrist_joint_effort" value="100" />
    <xacro:property name="wrist_joint_velocity" value="1.57" />
    <xacro:property name="arm_joint_damping" value="0.5" />
    <xacro:property name="arm_joint_friction" value="0.1" />

    <link name="arm_base_link">
        <visual>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}" />
            </geometry>
            <material name="Gray" />
            <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${arm_base_length} ${arm_base_width} ${arm_base_height}" />
            </geometry>
            <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${arm_base_height/2}" rpy="0 0 0" />
            <mass value="${arm_base_mass}" />
            <xacro:box_inertia m="${arm_base_mass}" x="${arm_base_length}" y="${arm_base_width}" z="${arm_base_height}" />
        </inertial>
    </link>

    <link name="shoulder_link">
        <visual>
            <geometry>
                <cylinder length="${shoulder_length}" radius="${shoulder_radius}" />
            </geometry>
            <material name="Blue" />
            <origin xyz="0 0 ${shoulder_length/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${shoulder_radius} ${shoulder_radius} ${shoulder_length}" />
            </geometry>
            <origin xyz="0 0 ${shoulder_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${shoulder_length/2}" rpy="0 0 0" />
            <mass value="${shoulder_mass}" />
            <xacro:cylinder_inertia m="${shoulder_mass}" r="${shoulder_radius}" h="${shoulder_length}" />
        </inertial>
    </link>

    <link name="arm_link">
        <visual>
            <geometry>
                <cylinder length="${arm_length}" radius="${arm_radius}" />
            </geometry>
            <material name="Gray" />
            <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${arm_radius} ${arm_radius} ${arm_length}" />
            </geometry>
            <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0" />
            <mass value="${arm_mass}" />
            <xacro:cylinder_inertia m="${arm_mass}" r="${arm_radius}" h="${arm_length}" />
        </inertial>
    </link>

    <link name="elbow_link">
        <visual>
            <geometry>
                <cylinder length="${elbow_length}" radius="${elbow_radius}" />
            </geometry>
            <material name="Blue" />
            <origin xyz="0 0 ${elbow_length/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${elbow_radius} ${elbow_radius} ${elbow_length}" />
            </geometry>
            <origin xyz="0 0 ${elbow_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${elbow_length/2}" rpy="0 0 0" />
            <mass value="${elbow_mass}" />
            <xacro:cylinder_inertia m="${elbow_mass}" r="${elbow_radius}" h="${elbow_length}" />
        </inertial>
    </link>

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder length="${forearm_length}" radius="${forearm_radius}" />
            </geometry>
            <material name="Gray" />
            <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${forearm_radius} ${forearm_radius} ${forearm_length}" />
            </geometry>
            <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0" />
            <mass value="${forearm_mass}" />
            <xacro:cylinder_inertia m="${forearm_mass}" r="${forearm_radius}" h="${forearm_length}" />
        </inertial>
    </link>

    <link name="wrist_link">
        <visual>
            <geometry>
                <box size="${wrist_length} ${wrist_width} ${wrist_height}" />
            </geometry>
            <material name="Blue" />
            <origin xyz="0 0 ${wrist_height/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${wrist_length} ${wrist_width} ${wrist_height}" />
            </geometry>
            <origin xyz="0 0 ${wrist_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${wrist_height/2}" rpy="0 0 0" />
            <mass value="${wrist_mass}" />
            <xacro:box_inertia m="${wrist_mass}" x="${wrist_length}" y="${wrist_width}" z="${wrist_height}" />
        </inertial>
    </link>

    <link name="hand_link">
        <visual>
            <geometry>
                <box size="${hand_length} ${hand_width} ${hand_height}" />
            </geometry>
            <material name="Gray" />
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
        </visual>
        <collision>
            <geometry>
                <box size="${hand_length} ${hand_width} ${hand_height}" />
            </geometry>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
            <mass value="${hand_mass}" />
            <xacro:box_inertia m="${hand_mass}" x="${hand_length}" y="${hand_width}" z="${hand_height}" />
        </inertial>
    </link>

    <link name="tool_link" />

    <joint name="joint1" type="revolute">
        <parent link="arm_base_link" />
        <child link="shoulder_link" />
        <origin xyz="0 0 ${arm_base_height}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="${arm_joint_effort}" velocity="${arm_joint_velocity}" lower="-3.14" upper="3.14" />
        <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}" />
    </joint>

    <joint name="joint2" type="revolute">
        <parent link="shoulder_link" />
        <child link="arm_link" />
        <origin xyz="0 0 ${shoulder_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <!-- lower slightly below 0: Gazebo/ros2_control rest pose can be ~-1e-12 -->
        <limit effort="${arm_joint_effort}" velocity="${arm_joint_velocity}" lower="-0.01" upper="2.5" />
        <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}" />
    </joint>

    <joint name="joint3" type="revolute">
        <parent link="arm_link" />
        <child link="elbow_link" />
        <origin xyz="0 0 ${arm_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="${arm_joint_effort}" velocity="${arm_joint_velocity}" lower="-0.01" upper="2.5" />
        <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}" />
    </joint>

    <joint name="joint4" type="revolute">
        <parent link="elbow_link" />
        <child link="forearm_link" />
        <origin xyz="0 0 ${elbow_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="${wrist_joint_effort}" velocity="${wrist_joint_velocity}" lower="-3.14" upper="3.14" />
        <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}" />
    </joint>

    <joint name="joint5" type="revolute">
        <parent link="forearm_link" />
        <child link="wrist_link" />
        <origin xyz="0 0 ${forearm_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="${wrist_joint_effort}" velocity="${wrist_joint_velocity}" lower="-1.57" upper="1.57" />
        <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}" />
    </joint>

    <joint name="joint6" type="continuous">
        <parent link="wrist_link" />
        <child link="hand_link" />
        <origin xyz="0 0 ${wrist_height}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <!-- velocity required: Jazzy JTC on_init reads limits->velocity (null => segfault) -->
        <limit effort="${wrist_joint_effort}" velocity="${wrist_joint_velocity}" />
        <dynamics damping="${arm_joint_damping}" friction="${arm_joint_friction}" />
    </joint>

    <joint name="hand_tool_joint" type="fixed">
        <parent link="hand_link" />
        <child link="tool_link" />
        <origin xyz="0 0 ${hand_height}" rpy="0 0 0" />
    </joint>

</robot>
