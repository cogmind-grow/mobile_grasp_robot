<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="growing_bot">

    <xacro:macro name="ros2_control_position_joint" params="name">
        <joint name="${name}">
            <command_interface name="position" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
    </xacro:macro>

    <ros2_control name="GrowingBotHardwareInterface" type="system">
        <hardware>
            <xacro:if value="$(arg ros_control_enabled)">
                <xacro:if value="$(arg sim_gz)">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:unless value="$(arg sim_gz)">
                    <plugin>gazebo_ros2_control/GazeboSystem</plugin>
                </xacro:unless>
            </xacro:if>
            <xacro:unless value="$(arg ros_control_enabled)">
                <plugin>mock_components/GenericSystem</plugin>
                <param name="calculate_dynamics">true</param>
            </xacro:unless>
        </hardware>

        <!-- Wheels via DiffDriveController (GazeboSystem SetVelocity needs non-zero effort limit) -->
        <joint name="base_left_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="base_right_joint">
            <command_interface name="velocity" />
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <xacro:if value="$(arg arm_enabled)">
            <xacro:ros2_control_position_joint name="joint1" />
            <xacro:ros2_control_position_joint name="joint2" />
            <xacro:ros2_control_position_joint name="joint3" />
            <xacro:ros2_control_position_joint name="joint4" />
            <xacro:ros2_control_position_joint name="joint5" />
            <xacro:ros2_control_position_joint name="joint6" />

            <xacro:ros2_control_position_joint name="gripper_left_finger_joint" />
            <xacro:ros2_control_position_joint name="gripper_right_finger_joint" />
        </xacro:if>
    </ros2_control>

</robot>
